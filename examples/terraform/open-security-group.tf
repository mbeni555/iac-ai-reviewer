# Deliberately vulnerable sample for IaC AI Reviewer.
# Do not use this configuration in a real account.

resource "aws_security_group" "web" {
  name        = "web-open"
  description = "intentionally open for the demo"
  vpc_id      = "vpc-demo"

  ingress {
    description = "SSH from anywhere"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "all traffic from anywhere"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
